{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "url": "https://raw.githubusercontent.com/kluk0007/Monash_FIT3179_Homework_Week_10/refs/heads/main/data/overseas_migrant_arrivals_age_and_sex.csv" },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "Age"
    },
    "y": {
      "aggregate": "sum",
      "field": "2018-2019 Males Thousand",
      "type": "quantitative",
      "title": "Overseas Migrant Arrivals",
      "scale": {"domain":[0,20]}
    },
    "tooltip": {"field": "2018-2019 Males Thousand"}
  }
}
